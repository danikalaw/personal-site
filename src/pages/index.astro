---
import BaseLayout from "../components/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { posts } from "../data/site";

const latest = posts.slice(0, 5);
---

<BaseLayout>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="eyebrow">Data scientist · Microsoft · British Columbia</p>
      <h1 id="hero-title">Discovering <em>stories and insights</em> in data.</h1>
      <p class="hero__intro">
        I enjoy using statistics, machine learning, and data visualization to uncover actionable insights regardless of industry. I especially enjoy projects which push the limits of my expertise, challenging me to expand my depth and breadth of knowledge.
      </p>
      <a class="hero__jump" href="#writing">
        Read my writing <span class="hero__jump-line" aria-hidden="true"></span><span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <section class="latest" id="writing" aria-labelledby="writing-title">
    <div class="section-heading section-heading--short">
      <p class="eyebrow">Latest writing</p>
      <h2 id="writing-title">Recent posts.</h2>
    </div>

    <div class="latest__grid">
      <PostCard post={latest[0]} featured />
      <div class="latest__list">
        {latest.slice(1).map((post) => <PostCard post={post} />)}
      </div>
    </div>

    <a class="section-link" href="/writing/">Browse all 33 posts <span aria-hidden="true">→</span></a>
  </section>

  <section class="about" id="about" aria-labelledby="about-title">
    <div class="about__portrait">
      <img
        src="/media/2021/07/familyphotos-teasers-27-2-scaled.jpg"
        alt="Danika outdoors with her family"
        width="2560"
        height="1707"
        loading="lazy"
        decoding="async"
      />
      <p><span>Based in</span> British Columbia</p>
    </div>

    <div class="about__copy">
      <p class="eyebrow">About</p>
      <h2 id="about-title">What do you want to learn?</h2>
      <div class="about__columns">
        <p>
          I am a data scientist who loves discovering stories and insights in data. I currently work as a Senior Data &amp; Applied Scientist at Microsoft.
        </p>
        <p>
          Rather than focus on the approach, I like to focus on the question: What do you want to learn, and what questions are you seeking answers for that will drive your business to success?
        </p>
      </div>
      <ul class="about__tools" aria-label="Technical tools">
        <li>Statistics</li><li>Machine learning</li><li>Data visualization</li><li>R</li><li>Python</li><li>SQL</li>
      </ul>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-title">Get in touch.</h2>
    <a href="mailto:danikalaw@gmail.com">Write to Danika <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
